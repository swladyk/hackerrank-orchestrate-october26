# Copy to .env (git-ignored) and fill in. Real environment variables take precedence over this file.
# Keep comments on their own lines: values are read verbatim up to the end of the line.

# Required for online runs. Not needed for `--offline` (cached answers only).
OPENAI_API_KEY=

# Optional: model for intent classification (Decisions API)
# DECISIONS_MODEL=gpt-6-luna
# Optional: model for screenshot / PDF extraction (Responses API, JSON schema)
# VISION_MODEL=gpt-6-luna
# Optional: token prices in USD per 1M tokens, used for the cost estimate
# PRICING_JSON={"gpt-6-luna": {"input": 0.10, "cached_input": 0.01, "output": 0.50}}
